# MongoDB connection string (Atlas or local).
MONGODB_URI=

# Supabase project — the API verifies access tokens against its JWKS. This is
# the only Supabase var the API needs (no secret). Same project as the frontend.
SUPABASE_URL=

# Run WITHOUT auth on purpose (local dev, CI). Without this and without
# SUPABASE_URL the API fails closed instead of serving anonymous requests.
AUTH_DISABLED=true
# Optional: the userId to attach to requests in AUTH_DISABLED mode (so local
# data is scoped to a stable id rather than null).
AUTH_DISABLED_USER_ID=

# Comma-separated CORS allowlist. The deployed frontend's origin in production.
CORS_ORIGIN=http://localhost:3001

PORT=3000
