{
  "name": "job-tracker-api",
  "version": "1.0.0",
  "description": "Express + Mongoose API for a Kanban job-application tracker. Supabase JWT auth, per-user data scoping.",
  "main": "server.js",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "backend": "nodemon server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "Alexandra Petryga",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "jose": "^6.2.8",
    "mongoose": "^9.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/env.js"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js",
      "routes/**/*.js",
      "middleware/**/*.js",
      "config/**/*.js",
      "app.js"
    ],
    "testTimeout": 20000,
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ]
  }
}
